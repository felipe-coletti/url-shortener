# Aplicação
# A maioria das hospedagens define PORT automaticamente.
PORT=3000
# URL pública do site, sem barra no final. Se vazia, é deduzida de cada requisição.
BASE_URL=http://localhost:3000
# Quantidade de proxies na frente do app (1 na maioria das hospedagens), ou "false".
TRUST_PROXY=1
# Domínios que não podem ser encurtados, separados por vírgula (subdomínios inclusos).
BLOCKED_HOSTS=

# Banco de dados
MONGO_URI=mongodb://localhost:27017/url-shortener

# Anúncios (opcional). Copie o endereço do script e o ID da zona do painel do seu provedor.
AD_SCRIPT_SRC=
AD_ZONE_ID=
